# ==============================================================================
# Data Detective - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Allowed Origins for CORS (comma-separated list, or '*' for development)
# In production, set to your specific frontend URL(s), e.g. "https://datadetective.example.com"
ALLOWED_ORIGINS=*

# Dataset File Upload Limits
MAX_FILE_SIZE_MB=10

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

